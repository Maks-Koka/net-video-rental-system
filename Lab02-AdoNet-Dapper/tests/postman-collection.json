{
  "info": {
    "name": "Video Rental API (Лаб. 02)",
    "description": "Мікросервіс «Оренда фільмів» системи управління відеопрокатом.\nТришарова архітектура на ADO.NET та Dapper.\n\nВстановіть змінну baseUrl (за замовчуванням http://localhost:5190)\nі запустіть Runner: запити виконуються в порядку, що демонструє\nповний життєвий цикл оренди та всі критичні статуси (201/200/204/400/404/409).\n\nУВАГА: колекція змінює стан бази. Перед повторним прогоном\nперезасійте БД скриптами з Лаб. 01.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5190", "type": "string" },
    { "key": "rentalId", "value": "", "type": "string" },
    { "key": "cancelRentalId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "00. Health — база досяжна",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "pm.test('статус Healthy', () => pm.expect(pm.response.json().status).to.eql('Healthy'));"
        ], "type": "text/javascript" }
      }]
    },
    {
      "name": "01. GET /api/movies — локальна копія довідника",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/movies", "host": ["{{baseUrl}}"], "path": ["api", "movies"] }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "pm.test('список непорожній', () => pm.expect(pm.response.json().length).to.be.above(0));",
          "pm.test('кирилиця збереглася', () => pm.expect(JSON.stringify(pm.response.json())).to.include('Тіні забутих предків'));"
        ], "type": "text/javascript" }
      }]
    },
    {
      "name": "02. GET /api/rentals/3 — оренда з позиціями (Dapper multi-mapping)",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/rentals/3", "host": ["{{baseUrl}}"], "path": ["api", "rentals", "3"] }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "const b = pm.response.json();",
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "pm.test('деталі оренди прийшли (зв\\'язок 1:1)', () => pm.expect(b.detail).to.not.be.null);",
          "pm.test('дві позиції (зв\\'язок M:N)', () => pm.expect(b.items.length).to.eql(2));",
          "pm.test('знімки полів каталогу в позиціях', () => b.items.forEach(i => { pm.expect(i.movieTitle).to.be.a('string').and.not.empty; pm.expect(i.dailyRate).to.be.above(0); }));",
          "pm.test('пеню нарахувала процедура (64.75)', () => pm.expect(b.lateFeeAmount).to.eql(64.75));"
        ], "type": "text/javascript" }
      }]
    },
    {
      "name": "03. GET неіснуючий Id -> 404 ProblemDetails (НЕ 500)",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/rentals/999999", "host": ["{{baseUrl}}"], "path": ["api", "rentals", "999999"] }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
          "const b = pm.response.json();",
          "pm.test('формат ProblemDetails', () => { pm.expect(b).to.have.property('type'); pm.expect(b).to.have.property('title'); pm.expect(b).to.have.property('status'); });",
          "pm.test('є traceId', () => pm.expect(b.traceId).to.be.a('string'));"
        ], "type": "text/javascript" }
      }]
    },
    {
      "name": "04. POST confirm вже поверненої -> 409 (THROW 50002)",
      "request": {
        "method": "POST",
        "url": { "raw": "{{baseUrl}}/api/rentals/3/confirm", "host": ["{{baseUrl}}"], "path": ["api", "rentals", "3", "confirm"] }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
          "pm.test('повідомлення прийшло зі збережуваної процедури', () => pm.expect(pm.response.json().detail).to.include('only for a new rental'));"
        ], "type": "text/javascript" }
      }]
    },
    {
      "name": "05. POST cancel виданої на руки -> 409",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"reason\": \"перевірка недопустимого переходу\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/rentals/2/cancel", "host": ["{{baseUrl}}"], "path": ["api", "rentals", "2", "cancel"] }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
          "pm.test('скасувати можна лише до оренди', () => pm.expect(pm.response.json().detail).to.include('before the movies are pickedUp'));"
        ], "type": "text/javascript" }
      }]
    },
    {
      "name": "06. POST з порожніми полями -> 400 з помилками по полях",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"customerId\": 1,\n  \"dueDate\": \"2026-12-31\",\n  \"pickupStore\": \"\",\n  \"items\": []\n}" },
        "url": { "raw": "{{baseUrl}}/api/rentals", "host": ["{{baseUrl}}"], "path": ["api", "rentals"] }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
          "const e = pm.response.json().errors;",
          "pm.test('помилки розбиті по полях', () => { pm.expect(e).to.be.an('object'); pm.expect(Object.keys(e).length).to.be.above(1); });"
        ], "type": "text/javascript" }
      }]
    },
    {
      "name": "07. ВІДКАТ: замовити 99 дисків при 1 наявному -> 409",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
        "body": { "mode": "raw", "raw": "{\n  \"customerId\": 1,\n  \"dueDate\": \"2026-12-31\",\n  \"pickupStore\": \"Центральний магазин\",\n  \"items\": [{ \"movieId\": 6, \"units\": 99 }]\n}" },
        "url": { "raw": "{{baseUrl}}/api/rentals", "host": ["{{baseUrl}}"], "path": ["api", "rentals"] }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
          "pm.test('бізнес-перевірка спрацювала', () => pm.expect(pm.response.json().detail).to.include('discs available'));"
        ], "type": "text/javascript" }
      }]
    },
    {
      "name": "08. Залишок НЕ змінився після відкату",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/movies/6", "host": ["{{baseUrl}}"], "path": ["api", "movies", "6"] }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "pm.test('дисків як було (1)', () => pm.expect(pm.response.json().discsAvailable).to.eql(1));"
        ], "type": "text/javascript" }
      }]
    },
    {
      "name": "09. POST /api/rentals -> 201 Created + Location",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
        "body": { "mode": "raw", "raw": "{\n  \"customerId\": 1,\n  \"dueDate\": \"2026-12-31\",\n  \"pickupStore\": \"Центральний магазин\",\n  \"comment\": \"Postman: повний цикл\",\n  \"items\": [{ \"movieId\": 1, \"units\": 1 }, { \"movieId\": 2, \"units\": 1 }]\n}" },
        "url": { "raw": "{{baseUrl}}/api/rentals", "host": ["{{baseUrl}}"], "path": ["api", "rentals"] }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('201 Created', () => pm.response.to.have.status(201));",
          "pm.test('є заголовок Location', () => pm.expect(pm.response.headers.has('Location')).to.be.true);",
          "const b = pm.response.json();",
          "pm.test('статус Submitted', () => pm.expect(b.status).to.eql('Submitted'));",
          "pm.test('позиції отримали знімки з довідника', () => b.items.forEach(i => pm.expect(i.movieTitle).to.not.be.empty));",
          "pm.collectionVariables.set('rentalId', b.id);"
        ], "type": "text/javascript" }
      }]
    },
    {
      "name": "10. POST issue -> 200 (транзакція: статус + залишок)",
      "request": {
        "method": "POST",
        "url": { "raw": "{{baseUrl}}/api/rentals/{{rentalId}}/issue", "host": ["{{baseUrl}}"], "path": ["api", "rentals", "{{rentalId}}", "issue"] }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "pm.test('статус PickedUp', () => pm.expect(pm.response.json().status).to.eql('PickedUp'));"
        ], "type": "text/javascript" }
      }]
    },
    {
      "name": "11. GET history — журнал переходів статусів",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/rentals/{{rentalId}}/history", "host": ["{{baseUrl}}"], "path": ["api", "rentals", "{{rentalId}}", "history"] }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "pm.test('щонайменше 3 переходи', () => pm.expect(pm.response.json().length).to.be.at.least(3));"
        ], "type": "text/javascript" }
      }]
    },
    {
      "name": "12. POST return -> 200, пеня 0 (у термін)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{}" },
        "url": { "raw": "{{baseUrl}}/api/rentals/{{rentalId}}/return", "host": ["{{baseUrl}}"], "path": ["api", "rentals", "{{rentalId}}", "return"] }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "const b = pm.response.json();",
          "pm.test('статус Returned', () => pm.expect(b.status).to.eql('Returned'));",
          "pm.test('пеня 0 — повернено в термін', () => pm.expect(b.lateFeeAmount).to.eql(0));"
        ], "type": "text/javascript" }
      }]
    },
    {
      "name": "13. POST нову оренду для скасування -> 201",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
        "body": { "mode": "raw", "raw": "{\n  \"customerId\": 2,\n  \"dueDate\": \"2026-12-31\",\n  \"pickupStore\": \"Магазин №2\",\n  \"items\": [{ \"movieId\": 5, \"units\": 1 }]\n}" },
        "url": { "raw": "{{baseUrl}}/api/rentals", "host": ["{{baseUrl}}"], "path": ["api", "rentals"] }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('201 Created', () => pm.response.to.have.status(201));",
          "pm.collectionVariables.set('cancelRentalId', pm.response.json().id);"
        ], "type": "text/javascript" }
      }]
    },
    {
      "name": "14. POST cancel НОВОЇ оренди -> 200 Cancelled",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
        "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Клієнт передумав\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/rentals/{{cancelRentalId}}/cancel", "host": ["{{baseUrl}}"], "path": ["api", "rentals", "{{cancelRentalId}}", "cancel"] }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "pm.test('статус Cancelled', () => pm.expect(pm.response.json().status).to.eql('Cancelled'));"
        ], "type": "text/javascript" }
      }]
    },
    {
      "name": "15. Спецсимвол O'Brien читається коректно",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/customers", "host": ["{{baseUrl}}"], "path": ["api", "customers"] }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "const o = pm.response.json().filter(r => r.fullName.includes('Brien'));",
          "pm.test('клієнт Liam O\\'Brien є і прочитався без помилки SQL', () => { pm.expect(o.length).to.eql(1); pm.expect(o[0].fullName).to.eql(\"Liam O'Brien\"); });"
        ], "type": "text/javascript" }
      }]
    },
    {
      "name": "16. Спроба SQL-ін'єкції в ?title -> порожній результат",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/movies?title=%27%20OR%201%3D1%20--",
          "host": ["{{baseUrl}}"], "path": ["api", "movies"],
          "query": [{ "key": "title", "value": "%27%20OR%201%3D1%20--" }]
        }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('200 OK — запит не зламався', () => pm.response.to.have.status(200));",
          "pm.test('повернуто 0 фільмів, а не всі (параметризація працює)', () => pm.expect(pm.response.json().length).to.eql(0));"
        ], "type": "text/javascript" }
      }]
    },
    {
      "name": "17. Ідемпотентність: повтор оплати пені (ключ seed-latefee-1)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"amount\": 64.75,\n  \"method\": \"Card\",\n  \"idempotencyKey\": \"seed-latefee-1\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/rentals/3/late-fees", "host": ["{{baseUrl}}"], "path": ["api", "rentals", "3", "late-fees"] }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('повернуто наявний платіж, а не створено новий', () => pm.expect(pm.response.json().idempotencyKey).to.eql('seed-latefee-1'));"
        ], "type": "text/javascript" }
      }]
    },
    {
      "name": "18. GET late-fees — створено рівно один платіж",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/rentals/3/late-fees", "host": ["{{baseUrl}}"], "path": ["api", "rentals", "3", "late-fees"] }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "pm.test('дублікат не створено (1 платіж)', () => pm.expect(pm.response.json().length).to.eql(1));"
        ], "type": "text/javascript" }
      }]
    },
    {
      "name": "19. GET rental-summary — звіт із процедури + view",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/customers/3/rental-summary", "host": ["{{baseUrl}}"], "path": ["api", "customers", "3", "rental-summary"] }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "const r = pm.response.json()[0];",
          "pm.test('звіт містить агрегати', () => { pm.expect(r).to.have.property('titlesCount'); pm.expect(r).to.have.property('dailyChargeTotal'); });"
        ], "type": "text/javascript" }
      }]
    },
    {
      "name": "20. rental-summary для неіснуючого клієнта -> 404 (THROW 50001)",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/customers/999999/rental-summary", "host": ["{{baseUrl}}"], "path": ["api", "customers", "999999", "rental-summary"] }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [

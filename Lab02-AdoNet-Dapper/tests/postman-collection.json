      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "const p = Object.keys(pm.response.json().paths);",
          "pm.test('описано всі три групи ендпоінтів', () => { pm.expect(p.some(x => x.startsWith('/api/rentals'))).to.be.true; pm.expect(p.some(x => x.startsWith('/api/customers'))).to.be.true; pm.expect(p.some(x => x.startsWith('/api/movies'))).to.be.true; });"
        ], "type": "text/javascript" }
      }]
    }
  ]
}

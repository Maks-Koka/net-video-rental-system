{
  "AllowedHosts": "*",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Information"
      }
    }
  },

  "//": [
    "Маршрути (Routes) та кластери (Clusters) YARP.",
    "Адреси кластерів — ЛОГІЧНІ імена ресурсів AppHost (http://rentals-api),",
    "а не localhost:port: реальну адресу підставляє service discovery Aspire",
    "через AddServiceDiscoveryDestinationResolver().",
    "",
    "УВАГА — колізія шляхів. Сервіс Оренд (Лаб. 02) має власну локальну",
    "проєкцію довідника фільмів на /api/movies, і такий самий шлях має Каталог",
    "(Лаб. 03). Канонічним джерелом даних про фільми є Каталог, тому",
    "/api/movies веде в catalog-api, а проєкція сервісу Оренд доступна через",
    "/api/rentals/movies (префікс знімається трансформацією PathRemovePrefix).",
    "",
    "Order: менше число = вищий пріоритет. Специфічніші маршрути",
    "(/api/rentals/movies, /api/aggregator) мають бути вище за загальні."
  ],

  "ReverseProxy": {
    "Routes": {
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 1,
        "Match": { "Path": "/api/aggregator/{**catch-all}" },
        "Metadata": { "Team": "platform", "Version": "v1" }
      },

      "rentals-movies": {
        "ClusterId": "rentals",
        "Order": 2,
        "Match": { "Path": "/api/rentals/movies/{**catch-all}" },
        "//": "PathPattern переписує шлях ПОВНІСТЮ: /api/rentals/movies/1 -> /api/movies/1. PathRemovePrefix тут не підходить — він дав би /movies/1 без префікса /api.",
        "Transforms": [ { "PathPattern": "/api/movies/{**catch-all}" } ],
        "Metadata": { "Team": "rentals", "Version": "v1" }
      },

      "rentals": {
        "ClusterId": "rentals",
        "Order": 5,
        "Match": { "Path": "/api/rentals/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "rentals", "Version": "v1" }
      },
      "customers": {
        "ClusterId": "rentals",
        "Order": 5,
        "Match": { "Path": "/api/customers/{**catch-all}" },
        "Metadata": { "Team": "rentals", "Version": "v1" }
      },

      "movies": {
        "ClusterId": "catalog",
        "Order": 5,
        "Match": { "Path": "/api/movies/{**catch-all}" },
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "directors": {
        "ClusterId": "catalog",
        "Order": 5,
        "Match": { "Path": "/api/directors/{**catch-all}" },
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "genres": {
        "ClusterId": "catalog",
        "Order": 5,
        "Match": { "Path": "/api/genres/{**catch-all}" },
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },

      "reviews": {
        "ClusterId": "reviews",
        "Order": 5,
        "Match": { "Path": "/api/reviews/{**catch-all}" },
        "Metadata": { "Team": "reviews", "Version": "v1" }
      },
      "discussions": {
        "ClusterId": "reviews",
        "Order": 5,
        "Match": { "Path": "/api/discussions/{**catch-all}" },
        "Metadata": { "Team": "reviews", "Version": "v1" }
      }
    },

    "Clusters": {
      "aggregator": {
        "Destinations": { "d1": { "Address": "http://aggregator" } },
        "HttpRequest": { "ActivityTimeout": "00:00:30" }
      },
      "rentals": {
        "Destinations": { "d1": { "Address": "http://rentals-api" } },
        "HttpRequest": { "ActivityTimeout": "00:00:30" }
      },
      "catalog": {
        "Destinations": { "d1": { "Address": "http://catalog-api" } },
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": { "ActivityTimeout": "00:00:30" }
      },
      "reviews": {
        "Destinations": { "d1": { "Address": "http://reviews-api" } },
        "HttpRequest": { "ActivityTimeout": "00:00:30" }
      }
    }
  }
}
